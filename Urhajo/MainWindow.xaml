<Window x:Class="Urhajo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urhajo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Button Content="Adatok betöltése" Click="betoltes" Height="30" Margin="5"/>
            <Button Content="Hány űrhajó van?" Click="mennyiUrhajo" Height="30" Margin="5"/>
            <Button Content="Melyiknek a legnagyobb a hatótávja?" Click="legnagyobbHatotav" Height="30" Margin="5"/>
            <Button Content="Kik voltak sikeres küldetésen?" Click="sikeresKuldetes" Height="30" Margin="5"/>
            <Button Content="Átlagos legénységszám" Click="atlagLegenyseg" Height="30" Margin="5"/>
            <Button Content="Gyártók szerinti csoportosítás" Click="gyartokCsoport" Height="30" Margin="5"/>
            <Button Content="Keresés név alapján" Height="30" Margin="5" Click="kereses"/>
            <TextBox x:Name="txtKereses" Height="25" Margin="5"/>
            <TextBlock x:Name="txtEredmeny" Foreground="White" FontSize="14" Margin="5" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid x:Name="dgUrhajok" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}"/>


    </Grid>
</Window>
